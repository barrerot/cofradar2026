{
  "name": "@cofradar/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "cargar:datos": "tsx scripts/cargar-supabase.ts",
    "exportar:datos": "tsx scripts/exportar-supabase.ts",
    "test": "tsx --test src/motor/*.test.ts src/rutas/*.test.ts",
    "esquema": "tsx scripts/aplicar-esquema.ts",
    "admin": "tsx scripts/admin.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "express": "^4.21.1",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "csv-parse": "^7.0.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
